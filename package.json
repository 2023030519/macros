{
  "name": "macros",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "desk": "npm run build && electron .",
    "exe": "npm run build && electron-builder --win nsis --publish never",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/lib/*.test.ts",
    "release": "node scripts/release.mjs",
    "apk": "npm run build && npx cap sync android && android\\gradlew.bat -p android assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/core": "6.2.3",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/preferences": "6.0.4",
    "@capacitor/share": "6.0.4",
    "@fontsource/geist-sans": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "typescript": "5.6.3",
    "vite": "6.4.5"
  },
  "build": {
    "appId": "mx.hecto.macros",
    "productName": "MacrOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!node_modules/**"
    ],
    "win": {
      "icon": "electron/icon.png",
      "artifactName": "MacrOS-${version}-setup.${ext}"
    }
  }
}
